# Unity standard .gitignore
# Recommended by GitHub & Unity Technologies

# --------------------------------------------------
# Unity generated folders & files
# --------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store tools
/[Aa]ssets/AssetStoreTools*

# Autogenerated meta files for ignored folders
/[Ll]ibrary.meta
/[Tt]emp.meta
/[Oo]bj.meta
/[Bb]uild.meta
/[Bb]uilds.meta
/[Ll]ogs.meta
/[Uu]ser[Ss]ettings.meta
/[Mm]emoryCaptures.meta
/[Rr]ecordings.meta

# --------------------------------------------------
# Visual Studio / Rider / VSCode generated files
# --------------------------------------------------
.vs/
.idea/
.vscode/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.sln.iml

# Unity3D generated meta files for compiled assemblies/debug files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --------------------------------------------------
# Unity crash reports & diagnostics
# --------------------------------------------------
sysinfo.txt
sysinfo.txt.meta
*.stackdump

# --------------------------------------------------
# Builds & Packages
# --------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Gradle cache
.gradle/

# --------------------------------------------------
# OS generated files
# --------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
